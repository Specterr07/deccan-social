# Template. Real values live in ./.env.local at the project root (git-ignored).
# Check them with: cd scripts && npm install && npm run check-env

# --- App ---
APP_URL=http://localhost:3000
APP_PASSWORD=change-me            # single shared login for the SLC
SESSION_SECRET=generate-a-long-random-string

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Claude API (planning, copy, captions) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_LIGHT=claude-haiku-4-5   # small jobs: single-post rewrites

# --- Higgsfield (artwork) ---  format: <api-key-id>:<api-key-secret>
HF_CREDENTIALS=
HIGGSFIELD_MODEL=higgsfield-ai/soul/v2/standard
HIGGSFIELD_COST_PER_IMAGE_USD=0.04   # set from the model's price in console.higgsfield.ai
IMAGE_VARIANTS_PER_SLIDE=3
MONTHLY_AI_BUDGET_INR=1500          # Claude + Higgsfield together
USD_INR_RATE=88

# --- Cloudflare R2 (S3-compatible storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deccan-social
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=Deccan Social <posts@yourdomain.com>
REVIEWER_EMAIL=
